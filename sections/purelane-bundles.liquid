{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}

<section id="bundles" class="purelane-bundles-section">

  <div class="purelane-wrapper">

    <div class="purelane-bundles__intro purelane-glass">

      {% if section.settings.kicker != blank %}
        <span class="purelane-kicker">
          {{ section.settings.kicker }}
        </span>
      {% endif %}

      <h2 class="purelane-heading-lg">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.description != blank %}
        <p class="purelane-lede">
          {{ section.settings.description }}
        </p>
      {% endif %}

    </div>

    <div class="purelane-bundles__tiers">
      {% for block in section.blocks %}
        {% render 'purelane-bundle-tier', block: block %}
      {% endfor %}
    </div>

  </div>

</section>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Starter"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured tier",
          "default": false
        },
        {
          "type": "range",
          "id": "quantity",
          "label": "Product quantity",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 2
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "unit_price",
          "label": "Unit price text",
          "default": "Flat ₹174 per product"
        },

        {
          "type": "product",
          "id": "product_1",
          "label": "Product image 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product image 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product image 3"
        },

        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },

        {
          "type": "text",
          "id": "button_label",
          "label": "Button",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        {
          "type": "tier"
        },
        {
          "type": "tier"
        },
        {
          "type": "tier"
        }
      ]
    }
  ]
}
{% endschema %}