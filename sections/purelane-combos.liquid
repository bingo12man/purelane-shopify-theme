{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

<section
  id="combos"
  class="purelane-combos-section"
>
  <div class="purelane-wrapper">

    <header class="purelane-combos__header">

      {% if section.settings.kicker != blank %}
        <span class="purelane-kicker">
          {{ section.settings.kicker }}
        </span>
      {% endif %}

      <h2 class="purelane-heading-lg">
        {{ section.settings.heading }}
      </h2>

      <div class="purelane-combos__rule" aria-hidden="true">
        <i></i>
        <span>◆</span>
        <i></i>
      </div>

      {% if section.settings.description != blank %}
        <p class="purelane-lede">
          {{ section.settings.description }}
        </p>
      {% endif %}

    </header>

    <div class="purelane-combos__rail">

      {% for block in section.blocks %}
        {% render 'purelane-combo-card',
          block: block
        %}
      {% endfor %}

    </div>

    <div class="purelane-combos__swipe">
      Swipe for more combos →
    </div>

    {% if section.settings.note != blank %}
      <p class="purelane-combos__note">
        {{ section.settings.note }}
      </p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Footer note",
      "default": "Choose a pre-built bundle or open the bundle product to see its details."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "product",
          "id": "bundle_product",
          "label": "Bundle product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured card",
          "default": false
        },
        {
          "type": "range",
          "id": "product_count",
          "label": "Number of products",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 3
        },

        {
          "type": "product",
          "id": "product_1",
          "label": "Included product 1"
        },
        {
          "type": "text",
          "id": "product_1_note",
          "label": "Product 1 benefit"
        },

        {
          "type": "product",
          "id": "product_2",
          "label": "Included product 2"
        },
        {
          "type": "text",
          "id": "product_2_note",
          "label": "Product 2 benefit"
        },

        {
          "type": "product",
          "id": "product_3",
          "label": "Included product 3"
        },
        {
          "type": "text",
          "id": "product_3_note",
          "label": "Product 3 benefit"
        },

        {
          "type": "textarea",
          "id": "description",
          "label": "Bundle description"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Purelane combos",
      "blocks": [
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}