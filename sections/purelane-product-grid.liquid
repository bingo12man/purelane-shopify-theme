{{ 'purelane-product-grid.css' | asset_url | stylesheet_tag }}

<section
  id="{{ section.settings.anchor_id | escape }}"
  class="purelane-product-grid-section"
>
  <div class="purelane-wrapper">

    <header class="purelane-product-grid__header">
      {% if section.settings.kicker != blank %}
        <span class="purelane-kicker">
          {{ section.settings.kicker }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="purelane-heading-lg purelane-product-grid__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="purelane-product-grid__rule" aria-hidden="true">
        <span></span>
        <span class="purelane-product-grid__leaf">◆</span>
        <span></span>
      </div>

      {% if section.settings.description != blank %}
        <p class="purelane-lede purelane-product-grid__description">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </header>

    {% if section.settings.collection != blank %}

      <div class="purelane-product-grid">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'purelane-product-card',
            product: product,
            show_rating: false
          %}
        {% endfor %}
      </div>

    {% elsif request.design_mode %}

      <div class="purelane-product-grid__empty purelane-glass">
        Select a collection in the theme editor.
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Purelane product grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor",
      "default": "shop"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane product grid"
    }
  ]
}
{% endschema %}