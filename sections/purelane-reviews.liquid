{{ 'purelane-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reviews.js' | asset_url }}" defer="defer"></script>

<section
  id="reviews"
  class="purelane-reviews-section"
  data-purelane-reviews
  data-auto-scroll="{{ section.settings.auto_scroll }}"
  data-scroll-speed="{{ section.settings.scroll_speed }}"
>

  <div class="purelane-wrapper">

    <div class="purelane-reviews__header">

      <span class="purelane-kicker">
        {{ section.settings.kicker }}
      </span>

      <div class="purelane-reviews__aggregates">

        <span>
          <span class="purelane-reviews__stars" aria-hidden="true">
            ★★★★★
          </span>

          <strong>{{ section.settings.rating }}</strong>

          from {{ section.settings.review_count }} reviews
        </span>

        <span>
          Loved by
          <strong>{{ section.settings.homes_count }}</strong>
          homes
        </span>

      </div>

      <div class="purelane-reviews__controls">

        <button
          type="button"
          class="purelane-reviews__control"
          data-review-prev
          aria-label="Show previous reviews"
        >
          ←
        </button>

        <button
          type="button"
          class="purelane-reviews__control"
          data-review-next
          aria-label="Show next reviews"
        >
          →
        </button>

      </div>

    </div>

  </div>

  <div
    class="purelane-reviews__rail"
    data-review-rail
    aria-label="Customer reviews"
  >

    {% for block in section.blocks %}
      <div
        class="purelane-reviews__item"
        {{ block.shopify_attributes }}
      >
        {% render 'purelane-review-card', block: block %}
      </div>
    {% endfor %}

  </div>

</section>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Overall rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Homes count",
      "default": "12 lakh+"
    },
    {
      "type": "checkbox",
      "id": "auto_scroll",
      "label": "Automatically scroll reviews",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Auto-scroll interval",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Review heading",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product",
          "default": "Laundry detergent"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Purelane reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}